# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{sh,bash}]
indent_size = 4
shell_variant = bash
binary_next_line = true
switch_case_indent = true

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.lua]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Git config files use tabs by convention.
[{.gitconfig,.gitmodules}]
indent_style = tab
