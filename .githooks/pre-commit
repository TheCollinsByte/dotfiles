#!/usr/bin/env bash
#
# Pre-commit hook: lint staged shell scripts and block obvious secrets.
#
# Enable with:  make hooks     (sets core.hooksPath=.githooks)
# Bypass with:  git commit --no-verify

set -euo pipefail

RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; NC='\033[0m'
fail() { echo -e "${RED}✗${NC} $1" >&2; }
warn() { echo -e "${YELLOW}!${NC} $1" >&2; }
ok()   { echo -e "${GREEN}✓${NC} $1"; }

status=0

# Staged, non-deleted files only.
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
[[ ${#staged[@]} -eq 0 ]] && exit 0

# ---- shell scripts ----
shell_files=()
for file in "${staged[@]}"; do
    [[ -f "$file" ]] || continue
    case "$file" in
        suckless/*|config/nvim/*) continue ;;          # vendored submodules
        *.sh|*.bash) shell_files+=("$file") ;;
        *) head -1 "$file" 2>/dev/null | grep -qE '^#!.*\b(ba)?sh\b' && shell_files+=("$file") ;;
    esac
done

if [[ ${#shell_files[@]} -gt 0 ]]; then
    for file in "${shell_files[@]}"; do
        if ! bash -n "$file" 2>/dev/null; then
            fail "syntax error: $file"
            status=1
        fi
    done

    if command -v shellcheck >/dev/null 2>&1; then
        if shellcheck --severity=warning "${shell_files[@]}"; then
            ok "shellcheck passed (${#shell_files[@]} file(s))"
        else
            fail "shellcheck found problems"
            status=1
        fi
    else
        warn "shellcheck not installed — skipping lint"
    fi
fi

# ---- secrets ----
if command -v gitleaks >/dev/null 2>&1; then
    if gitleaks protect --staged --no-banner --redact --config .gitleaks.toml; then
        ok "no secrets detected"
    else
        fail "gitleaks found potential secrets — commit blocked"
        status=1
    fi
else
    # Minimal fallback so the hook still catches the worst cases without gitleaks.
    # Capture first: piping into `grep -q` lets git die of SIGPIPE on a match,
    # and under pipefail that 141 makes the if see "no key" — a silent miss.
    staged_diff=$(git diff --cached -U0)
    if grep -qE '^\+.*-----BEGIN [A-Z ]*PRIVATE KEY' <<<"$staged_diff"; then
        fail "a private key appears in the staged diff — commit blocked"
        status=1
    fi
    warn "gitleaks not installed — only a minimal secret check ran"
fi

# ---- accidental runtime state ----
for file in "${staged[@]}"; do
    case "$file" in
        *.log|config/htop/htop_history|config/nvim.bak.*)
            fail "runtime state should not be committed: $file"
            status=1
            ;;
    esac
done

[[ $status -eq 0 ]] || echo -e "\n${YELLOW}Bypass with:${NC} git commit --no-verify" >&2
exit $status
