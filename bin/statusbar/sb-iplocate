#!/bin/sh

# Gets your public ip address checks which country you are in and
# displays that information in the statusbar
#
# https://www.maketecheasier.com/ip-address-geolocation-lookups-linux/

set -e

# Check if geoiplookup is installed
if ! command -v geoiplookup >/dev/null 2>&1; then
    echo "Error: geoiplookup is not installed. Please install it and try again."
    exit 1
fi

# Fetch public IP and geolocation information
addr="$(geoiplookup "$(curl -sfm 1 ifconfig.me 2>/dev/null)")"
name="${addr##*, }"
flag="$(grep "flag: $name" "${XDG_DATA_HOME:-$HOME/.local/share}/thecollinsbyte/emoji")"
flag="${flag%% *}"
printf "%s %s\\n" "$flag" "$name"
