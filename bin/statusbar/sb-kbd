#!/bin/sh
# Active keyboard layout; hidden with only one. Left click: next layout.

query=$(setxkbmap -query 2>/dev/null)
layouts=$(echo "$query" | awk '/^layout:/ { print $2 }')
variants=$(echo "$query" | awk '/^variant:/ { print $2 }')
case $layouts in
    *,*) ;;
    *) exit 0 ;;
esac

case $BLOCK_BUTTON in
    1)
        # Rotate: the first layout in the list is the active one.
        layouts="${layouts#*,},${layouts%%,*}"
        if [ -n "$variants" ]; then
            # Variants pair with layouts by position, so rotate them together.
            variants="${variants#*,},${variants%%,*}"
            setxkbmap -layout "$layouts" -variant "$variants"
        else
            setxkbmap -layout "$layouts"
        fi
        ;;
    3) notify-send "⌨ Keyboard" "Active layout of: $layouts
Left click: switch to the next layout" ;;
esac

echo "⌨ ${layouts%%,*}"
