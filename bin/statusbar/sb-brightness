#!/bin/sh

# First backlight device; desktops and VMs have none, so show nothing.
set -- /sys/class/backlight/*
[ -r "$1/brightness" ] && [ -r "$1/max_brightness" ] || exit 0

# current brightness
curr_brightness=$(cat "$1/brightness")

# max_brightness
max_brightness=$(cat "$1/max_brightness")
[ "$max_brightness" -gt 0 ] 2>/dev/null || exit 0

# brightness percentage
brightness_per=$((100 * curr_brightness / max_brightness))

case $BLOCK_BUTTON in
    1) 
        ;;
    3) 
        notify-send "💡 Brightness module" "\- Shows current brightness level ☀️." 
        ;;
    6) 
        setsid -f "$TERMINAL" -e "$EDITOR" "$0"
        ;;
esac

echo "💡 ${brightness_per}%"
